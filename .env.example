# Supabase (Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Stripe (Developers > API keys)
STRIPE_SECRET_KEY=sk_test_...

# Stripe Webhook (Developers > Webhooks, after adding the endpoint)
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (Products > Creator / Studio)
STRIPE_PRICE_CREATOR_MONTHLY=price_...
STRIPE_PRICE_CREATOR_ANNUAL=price_...
STRIPE_PRICE_STUDIO_MONTHLY=price_...
STRIPE_PRICE_STUDIO_ANNUAL=price_...

# Where Stripe Checkout should redirect after success/cancel
# (your GitHub Pages site URL, e.g. https://username.github.io/repo/)
CLIENT_SUCCESS_URL=https://your-username.github.io/your-repo/
CLIENT_CANCEL_URL=https://your-username.github.io/your-repo/

# Port (Render sets this automatically, safe to leave as-is)
PORT=4000
